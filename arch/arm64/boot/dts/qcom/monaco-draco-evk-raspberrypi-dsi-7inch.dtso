/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

&{/} {
	display_bl: backlight {
		compatible = "pwm-backlight";
		power-supply = <&reg_dsi_panel>;
		pwms = <&reg_backlight 0 255 0>;
	};

	reg_dsi_panel: regulator-dsi-panel {
		compatible = "regulator-fixed";
		regulator-name = "rpi-dsi-panel";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	reg_dsi_touch: regulator-dsi-touch {
		compatible = "regulator-fixed";
		regulator-name = "rpi-touch";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&reg_backlight 1 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <50000>;
		enable-active-high;
	};
};

&hdmi_bridge {
	status = "disabled";
};

&hdmi_connector {
	status = "disabled";
};

&i2c_mux {
	i2c@0 {
		reg_backlight: regulator@45 {
			compatible = "raspberrypi,touchscreen-panel-regulator-v2";
			reg = <0x45>;
			#gpio-cells = <2>;
			gpio-controller;
			#pwm-cells = <3>;
		};

		touchscreen@5d {
			compatible = "goodix,gt911";
			reg = <0x5d>;
			AVDD28-supply = <&reg_dsi_touch>;
			touchscreen-size-x = <720>;
			touchscreen-size-y = <1280>;
		};
	};
};

&mdss_dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	panel@0 {
		compatible = "raspberrypi,dsi-7inch", "ilitek,ili9881c";
		reg = <0>;

		backlight = <&display_bl>;
		power-supply = <&reg_dsi_panel>;
		reset-gpios = <&reg_backlight 0 GPIO_ACTIVE_LOW>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1>;
	remote-endpoint = <&panel0_in>;
};
