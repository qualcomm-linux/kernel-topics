/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

#include "monaco-draco-ac-evk-som.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Monaco Draco EVK";
	compatible = "qcom,monaco-draco-evk", "qcom,qcs8300";
	chassis-type = "embedded";

	aliases {
		i2c8 = &i2c8;
		i2c13 = &i2c13;
		i2c14 = &i2c14;
		i2c15 = &i2c15;
	};

	dp0-connector {
		compatible = "dp-connector";
		label = "DP0";
		type = "full-size";

		dp-pwr-supply = <&vreg_dp0_pwr>;

		port {
			dp0_connector_in: endpoint {
				remote-endpoint = <&mdss_dp0_out>;
			};
		};
	};

	hdmi_connector: hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_connector_out: endpoint {
				remote-endpoint = <&hdmi_bridge_out>;
			};
		};
	};

	vreg_bridge_1p2: regulator-bridge-1p2 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_bridge_1p2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		vin-supply = <&vreg_bridge_3p3>;
	};

	vreg_bridge_3p3: regulator-bridge-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_bridge_3p3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&expander2 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vreg_dp0_pwr: regulator-dp0-pwr {
		compatible = "regulator-fixed";
		regulator-name = "VREG_DP0_PWR_3P3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&expander1 7 GPIO_ACTIVE_HIGH>;
	};
};

&i2c8 {
	status = "okay";

	i2c_mux: i2c-mux@70 {
		compatible = "nxp,pca9548";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;
		vdd-supply = <&vreg_s4a>;

		i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			hdmi_bridge: hdmi-bridge@41 {
				compatible = "lontium,lt9611uxd";
				reg = <0x41>;

				interrupts-extended = <&tlmm 76 IRQ_TYPE_EDGE_FALLING>;
				reset-gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;

				vcc-supply = <&vreg_bridge_3p3>;
				vdd-supply = <&vreg_bridge_1p2>;

				pinctrl-0 = <&bridge_rst_pin &bridge_irq_pin>;
				pinctrl-names = "default";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						hdmi_bridge_in: endpoint {
							remote-endpoint = <&mdss_dsi0_out>;
						};
					};

					port@2 {
						reg = <2>;
						hdmi_bridge_out: endpoint {
							remote-endpoint = <&hdmi_connector_out>;
						};
					};
				};
			};
		};
	};
};

&i2c14 {
	status = "okay";

	expander0: gpio@20 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x20>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander1: gpio@21 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x21>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander2: gpio@22 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x22>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander3: gpio@23 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x23>;
		#gpio-cells = <2>;
		gpio-controller;
	};
};

&i2c15 {
	status = "okay";

	expander4: gpio@38 {
		compatible = "ti,tca9538";
		reg = <0x38>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander5: gpio@3c {
		compatible = "ti,tca9538";
		reg = <0x3c>;
		#gpio-cells = <2>;
		gpio-controller;
	};
};

&mdss {
	status = "okay";
};

&mdss_dp0 {
	pinctrl-0 = <&dp_hot_plug_det>;
	pinctrl-names = "default";

	status = "okay";
};

&mdss_dp0_out {
	data-lanes = <0 1 2 3>;
	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000 8100000000>;
	remote-endpoint = <&dp0_connector_in>;
};

&mdss_dp0_phy {
	vdda-phy-supply = <&vreg_l5a>;
	vdda-pll-supply = <&vreg_l4a>;

	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l5a>;

	status = "okay";
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&hdmi_bridge_in>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l4a>;

	status = "okay";
};

&tlmm {
	bridge_rst_pin: bridge-rst-state {
		pins = "gpio3";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	bridge_irq_pin: bridge-irq-state {
		pins = "gpio76";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};
