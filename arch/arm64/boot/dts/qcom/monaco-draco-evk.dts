/dts-v1/;

#include "monaco-draco-ac-evk-som.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Monaco Draco EVK";
	compatible = "qcom,monaco-draco-evk", "qcom,qcs8300";
	chassis-type = "embedded";
};

&i2c14 {
	status = "okay";

	expander0: gpio@20 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x20>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander1: gpio@21 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x21>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander2: gpio@22 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x22>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander3: gpio@23 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x23>;
		#gpio-cells = <2>;
		gpio-controller;
	};

};

&i2c15 {
	status = "okay";

	expander4: gpio@38 {
		compatible = "ti,tca9538";
		reg = <0x38>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander5: gpio@3c {
		compatible = "ti,tca9538";
		reg = <0x3c>;
		#gpio-cells = <2>;
		gpio-controller;
	};
};
