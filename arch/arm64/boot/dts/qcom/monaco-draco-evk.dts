/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

#include "monaco-draco-ac-evk-som.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Monaco Draco EVK";
	compatible = "qcom,monaco-draco-evk", "qcom,qcs8300";
	chassis-type = "embedded";

	dp0-connector {
		compatible = "dp-connector";
		label = "DP0";
		type = "full-size";

		dp-pwr-supply = <&vreg_dp0_pwr>;

		port {
			dp0_connector_in: endpoint {
				remote-endpoint = <&mdss_dp0_out>;
			};
		};
	};

	vreg_dp0_pwr: regulator-dp0-pwr {
		compatible = "regulator-fixed";
		regulator-name = "VREG_DP0_PWR_3P3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&expander1 7 GPIO_ACTIVE_HIGH>;
	};
};

&i2c14 {
	status = "okay";

	expander0: gpio@20 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x20>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander1: gpio@21 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x21>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander2: gpio@22 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x22>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander3: gpio@23 {
		compatible = "kinetic,kts1622", "ti,tcal6416";
		reg = <0x23>;
		#gpio-cells = <2>;
		gpio-controller;
	};

};

&i2c15 {
	status = "okay";

	expander4: gpio@38 {
		compatible = "ti,tca9538";
		reg = <0x38>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	expander5: gpio@3c {
		compatible = "ti,tca9538";
		reg = <0x3c>;
		#gpio-cells = <2>;
		gpio-controller;
	};
};

&mdss {
	status = "okay";
};

&mdss_dp0 {
	pinctrl-0 = <&dp_hot_plug_det>;
	pinctrl-names = "default";

	status = "okay";
};

&mdss_dp0_out {
	data-lanes = <0 1 2 3>;
	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000 8100000000>;
	remote-endpoint = <&dp0_connector_in>;
};

&mdss_dp0_phy {
	vdda-phy-supply = <&vreg_l5a>;
	vdda-pll-supply = <&vreg_l4a>;

	status = "okay";
};
